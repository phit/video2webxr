{
    "name": "video2webxr",
    "version": "2.4.0",
    "description": "Watch YouTube 360°/VR180 videos and videos on other sites in your PC VR headset via WebXR",
    "manifest_version": 3,
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["script.js"]
        },
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["youtube-page.js"],
            "world": "MAIN"
        }
    ],
    "action": {
        "default_title": "Watch this video in VR",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_popup": "popup.html"
    },
    "permissions": ["activeTab", "scripting"],
    "web_accessible_resources": [
        {
            "resources": ["ort/*"],
            "matches": ["<all_urls>"],
            "use_dynamic_url": true
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "homepage_url": "https://github.com/phit/video2webxr"
}
