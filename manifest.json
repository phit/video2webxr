{
    "name": "video2webxr",
    "version": "2.0.0",
    "description": "Watch YouTube 360°/VR180 videos and videos on other sites in your PC VR headset via WebXR",
    "manifest_version": 3,
    "author": "phit, based on EnableYoutubePCVR by feedthedogs",
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*",
                "*://*.googlevideo.com/*"
            ],
            "js": [
                "script.js"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Watch this video in VR",
        "default_icon": "icon.png"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "icons": {
        "128": "icon.png"
    },
    "homepage_url": "https://github.com/phit/video2webxr"
}
