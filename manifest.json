{
    "name": "Enable Youtube PC VR in Chromium browsers",
    "version": "1.0.2",
    "description": "Enables PC-VR for YouTube 360°, VR180 and 3D videos, and for videos on other sites via the toolbar button - Tested on HTC Vive Cosmos",
    "manifest_version": 3,
    "author": "feedthedogs",
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*",
                "*://*.googlevideo.com/*"
            ],
            "js": [
                "script.js"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Watch this video in VR",
        "default_icon": "icon.png"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "icons": {
        "128": "icon.png"
    }
}
