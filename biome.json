{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": { "includes": ["src/**", "scripts/**", "*.json", "!package-lock.json"] },
    "formatter": { "indentStyle": "space", "indentWidth": 4, "lineWidth": 120 },
    "javascript": { "formatter": { "quoteStyle": "single" }, "globals": ["chrome", "DEBUG"] },
    "linter": {
        "rules": { "preset": "recommended", "correctness": { "noUndeclaredVariables": "error" } }
    }
}
